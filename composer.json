{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.0.0",
        "algolia/algoliasearch-client-php": "^1.25",
        "babenkoivan/scout-elasticsearch-driver": "^4.0",
        "barryvdh/laravel-cors": "^0.11.0",
        "barryvdh/laravel-debugbar": "^3.2",
        "barryvdh/laravel-dompdf": "^0.8.1",
        "bugsnag/bugsnag-laravel": "^2.0",
        "consoletvs/invoices": "^1.1",
        "daltcore/lara-pdf-merger": "^2.0",
        "doctrine/dbal": "^2.8",
        "fabpot/goutte": "^4.0",
        "fideloper/proxy": "~3.3",
        "fzaninotto/faker": "^1.7",
        "guzzlehttp/guzzle": "^6.3",
        "intervention/image": "^2.4",
        "jenssegers/date": "^3.5",
        "laravel/framework": "5.5.*",
        "laravel/scout": "^7.0",
        "laravel/tinker": "~1.0",
        "laravelcollective/html": "~5.0",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^5.3",
        "mpdf/mpdf": "^7.1",
        "nicolaslopezj/searchable": "1.*",
        "niklasravnsborg/laravel-pdf": "^2.0",
        "nullpunkt/lz-string-php": "^1.3",
        "opentok/opentok": "^4.5",
        "phpoffice/phpword": "^0.15.0",
        "simplesoftwareio/simple-qrcode": "~1",
        "spatie/laravel-permission": "^2.19",
        "uxweb/sweet-alert": "~1.4",
        "yajra/laravel-datatables-oracle": "~8.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "codeception/codeception": "^3.1",
        "filp/whoops": "~2.0",
        "laravel/dusk": "^2.0",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "~6.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }, 
        "files" :
        ["app/Helper.php","app/Http/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
             "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
            "platform": {
                "php": "7.1.3"
            },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        }
    }
}
